<Window x:Class="Swoop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Swoop settings" Width="520" Height="340" WindowStartupLocation="CenterOwner"
        Background="#11131B" Foreground="#F3F4FA" ResizeMode="NoResize">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Appearance &amp; storage" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,24"/>
        <TextBlock Grid.Row="1" Text="Theme" Foreground="#9DA4B8" Margin="0,0,0,6"/>
        <ComboBox Grid.Row="2" Name="ThemeCombo" Height="34" SelectedIndex="0">
            <ComboBoxItem Content="Midnight"/><ComboBoxItem Content="Aurora"/><ComboBoxItem Content="Ember"/>
        </ComboBox>
        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Personal background" Foreground="#9DA4B8"/>
                <TextBlock Name="BackgroundText" Text="No image selected" TextTrimming="CharacterEllipsis" Margin="0,5,12,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Choose image" Width="110" Height="30" Click="ChooseBackground_Click"/>
        </Grid>
        <Grid Grid.Row="4" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Download folder" Foreground="#9DA4B8"/>
                <TextBlock Name="FolderText" TextTrimming="CharacterEllipsis" Margin="0,5,12,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Choose folder" Width="110" Height="30" Click="ChooseFolder_Click"/>
        </Grid>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" Width="90" Height="32" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Save settings" Width="120" Height="32" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
